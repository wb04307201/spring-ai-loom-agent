        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- lib 的 playwright 是 optional(不传递);IT(HtmlRenderEngineIT)要真跑 Chromium,显式引入 -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Java 17 在中文 Windows 上默认字符集是 GBK；MCP SDK 0.18.x 的
                         StdioClientTransport 读 MCP 服务器 stdout 用平台默认字符集（写侧才是显式 UTF-8），
                         含非 ASCII 字符的 MCP 工具响应（如 mcp-server-chart 的 × / 弯引号）会被 GBK
                         解码破坏 JSON 结构 → JsonParseException → 响应被丢弃 → listTools 20s 超时 →
                         SyncMcp 跳过该 client（页面表现为该 MCP 缺席）。
                         强制 file.encoding=UTF-8 规避（JDK 18+ 默认 UTF-8 无此问题；
                         打包 jar 运行需同样加 -Dfile.encoding=UTF-8）。 -->
                    <jvmArguments>-Dfile.encoding=UTF-8</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
